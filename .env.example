# Copy to .env next to docker-compose.yml and change every value before exposing the app.
GOHIGH_VERSION=latest            # an image tag from https://github.com/anshnt/go-high/pkgs/container/go-high
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_URL=https://app.example.com
COOKIE_SECURE=1
# The address of your reverse proxy, so X-Forwarded-For is trusted only from it. Never "*".
FORWARDED_ALLOW_IPS=127.0.0.1
# Payments through Stripe Connect: the platform's secret key and the signing secret of the Connect webhook endpoint
# that points at https://app.example.com/api/hooks/payments/stripe. Leave empty to keep Stripe switched off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRETS=
