{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "message.sent",
  "description": "The provider accepted an outbound message (webchat replies are sent at once). Subject: the message.",
  "type": "object",
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "conversation_id": {"type": "string", "format": "uuid"},
    "contact_id": {"type": "string", "format": "uuid"},
    "channel_id": {"type": ["string", "null"], "format": "uuid"},
    "direction": {"type": "string"},
    "kind": {"type": "string"},
    "status": {"type": "string"},
    "subject": {"type": ["string", "null"]},
    "body": {"type": "string"},
    "thread_ref": {"type": ["string", "null"]},
    "provider_message_id": {"type": ["string", "null"]}
  },
  "required": ["id", "conversation_id", "contact_id", "channel_id", "direction", "kind", "status", "subject", "body", "thread_ref", "provider_message_id"],
  "additionalProperties": false
}
