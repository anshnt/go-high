{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task.updated",
  "description": "A task changed (a field, its assignee, its place in the manual order, or it was reopened). `data` is its new state and `changes` maps each changed field to its old and new value. Subject: the task.",
  "type": "object",
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "title": {"type": "string"},
    "notes": {"type": "string"},
    "due_at": {"type": ["string", "null"], "format": "date-time"},
    "all_day": {"type": "boolean"},
    "assignee_id": {"type": ["string", "null"], "format": "uuid"},
    "created_by": {"type": ["string", "null"], "format": "uuid"},
    "priority": {"type": "string", "enum": ["none", "low", "medium", "high"]},
    "status": {"type": "string", "enum": ["open", "done"]},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "record_id": {"type": ["string", "null"], "format": "uuid"},
    "recurrence": {"type": ["string", "null"]},
    "parent_task_id": {"type": ["string", "null"], "format": "uuid"},
    "depends_on_task_id": {"type": ["string", "null"], "format": "uuid"},
    "position": {"type": "number"},
    "changes": {"type": "object"}
  },
  "required": ["id", "title", "notes", "due_at", "all_day", "assignee_id", "created_by", "priority", "status", "completed_at", "record_id", "recurrence", "parent_task_id", "depends_on_task_id", "position", "changes"],
  "additionalProperties": false
}
