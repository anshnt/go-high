    "inclusive": {
      "type": "boolean"
    },
    "region": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
