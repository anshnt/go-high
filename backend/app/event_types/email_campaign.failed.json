{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "email_campaign.failed",
  "description": "A campaign could not start or continue (`error` says why). Subject: the campaign.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "status",
    "error"
  ],
  "additionalProperties": false
}
