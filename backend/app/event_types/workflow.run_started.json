{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow.run_started",
  "description": "A record entered a workflow. `event_id` is the event that triggered it. Test runs emit no events. Subject: the run.",
  "type": "object",
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "workflow_id": {"type": "string", "format": "uuid"},
    "workflow_name": {"type": "string"},
    "version": {"type": "integer"},
    "record_id": {"type": "string", "format": "uuid"},
    "event_id": {"type": ["integer", "null"]}
  },
  "required": ["id", "workflow_id", "workflow_name", "version", "record_id", "event_id"],
  "additionalProperties": false
}
