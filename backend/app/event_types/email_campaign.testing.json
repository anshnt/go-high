{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "email_campaign.testing",
  "description": "The A/B test sends of a campaign went out; the winner is chosen at `test_ends_at`. Subject: the campaign.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "test_ends_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "name",
    "status",
    "test_ends_at"
  ],
  "additionalProperties": false
}
