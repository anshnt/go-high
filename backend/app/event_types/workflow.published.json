{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow.published",
  "description": "A version of a workflow went live. `moved` and `exited` count the in-flight runs that the publish migrated to the new version or ended. Subject: the workflow.",
  "type": "object",
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "name": {"type": "string"},
    "version": {"type": "integer"},
    "version_id": {"type": "string", "format": "uuid"},
    "moved": {"type": "integer"},
    "exited": {"type": "integer"}
  },
  "required": ["id", "name", "version", "version_id", "moved", "exited"],
  "additionalProperties": false
}
