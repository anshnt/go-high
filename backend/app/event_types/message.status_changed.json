{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "message.status_changed",
  "description": "A delivery report moved an outbound message forward (delivered, read, or failed after sending). Reports never move a message backwards. Subject: the message.",
  "type": "object",
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "conversation_id": {"type": "string", "format": "uuid"},
    "contact_id": {"type": "string", "format": "uuid"},
    "channel_id": {"type": ["string", "null"], "format": "uuid"},
    "direction": {"type": "string"},
    "kind": {"type": "string"},
    "status": {"type": "string"},
    "subject": {"type": ["string", "null"]},
    "body": {"type": "string"},
    "thread_ref": {"type": ["string", "null"]},
    "error": {"type": ["string", "null"]},
    "previous": {"type": "string"}
  },
  "required": ["id", "conversation_id", "contact_id", "channel_id", "direction", "kind", "status", "subject", "body", "thread_ref", "error", "previous"],
  "additionalProperties": false
}
