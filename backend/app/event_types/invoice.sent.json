{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "invoice.sent",
  "description": "An invoice was issued: it has its number, its due date and a link the customer pays on. Email is not sent by the platform yet: a workflow can send the link on this event. Subject: the invoice.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "paid",
        "void",
        "uncollectible"
      ]
    },
    "billing_reason": {
      "type": "string"
    },
    "contact_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "currency": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "amount_paid": {
      "type": "integer"
    },
    "amount_due": {
      "type": "integer"
    },
    "subscription_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "number",
    "status",
    "billing_reason",
    "contact_id",
    "currency",
    "total",
    "amount_paid",
    "amount_due",
    "subscription_id",
    "due_at"
  ],
  "additionalProperties": false
}
