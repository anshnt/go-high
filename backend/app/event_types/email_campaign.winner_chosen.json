  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "winner": {
      "type": "string"
    },
    "rates": {
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "status",
    "winner",
    "rates"
  ],
  "additionalProperties": false
}
